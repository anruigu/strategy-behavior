# Heavy, regenerable experiment artifacts -- rebuild via the training/eval scripts.
# Per-run metrics, traces, and checkpoint manifests churn constantly and should not
# live in git. The small curated summaries under results/ ARE tracked.
runs/
logs/
logs_native/

# Raw SFT training corpora (large, regenerable with gen_sft.py).
# The tiny *.summary.json stat files ARE tracked.
data/*.jsonl

# Large raw eval-transfer blobs (sample dumps + side-by-side viewers).
# The small moved_*.json / MOVED_*.md summaries ARE tracked.
results/eval_transfer/am_samples.json
results/eval_transfer/side_by_side_*.html
