# Copy to .env and fill in. Scripts source this via $SAT_ENV_FILE (see config.sh).
# .env is gitignored -- never commit real keys.

# Tinker: the training/sampling API behind hole_exp and training/tinker.
# REQUIRED -- train_mixed.py, train_hole.py and post_run.py all fail without it.
TINKER_API_KEY=

# OpenRouter: used as the MASK judge backend (gpt-4.1) and, optionally, as a
# frontier eval opponent during training.
OPENROUTER_API_KEY=

# Weights & Biases: training passes --use-wb.
WANDB_API_KEY=

# Optional -- only needed for the S3 checkpoint tier in sync_checkpoints.sh.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_CHECKPOINT_BUCKET=my-bucket
# S3_PREFIX=spiral/qwen3-4b-base/<run-label>
