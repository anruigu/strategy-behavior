# secrets
.env

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# external checkouts (clone separately; see README)
/spiral/
/mask/
/machiavelli/

# heavy artifacts -- never commit
*.safetensors
*.bin
*.pt
ckpts/
oat-output*/
# $SAT_TINKER_OUT: per-run history.jsonl + checkpoints.jsonl
outputs/
prebuilt/
wandb/
*.log
slurm-*.out

# eval harness working copies + raw per-row CSVs (regenerate with the harness).
# The small metrics summaries under results/mask/*.json ARE tracked.
results/runs/
*.csv

# raw reasoning-bench transcripts get large; the *_metrics.json summaries ARE tracked.
results/reasoning/**/*.jsonl

# viz: large regenerable data blobs (rebuild with viz/build_data.py /
# viz/build_channels.py). The viz app (HTML + build scripts) IS tracked.
/viz/data.json
/viz/channels.json

# live-run traces (summaries and plots under benchmark/results are tracked)
benchmark/results/**/episodes/
benchmark/results/**/source/
benchmark/results/**/source_analysis/
benchmark/results/**/calls/
benchmark/results/**/traces/
benchmark/results/**/judge_calls/
benchmark/results/**/judge_v3_calls/
benchmark/results/**/*.sqlite
benchmark/results/**/chains/
