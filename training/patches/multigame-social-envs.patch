+# Liar's Dice, round-capped (two-player). A player is eliminated after losing
+# two dice, so an episode is ~2-3 rounds instead of ~6. The default num_dice=5
+# averages ~33 model calls per self-play episode -- as expensive per step as
+# PigDice -- which the 0806 multigame plan explicitly wanted bounded.
+register(
+    id="LiarsDice-v1-2d",
+    entry_point="spiral.envs.LiarsDice.env:LiarsDiceEnv",
+    num_dice=2,
+)
